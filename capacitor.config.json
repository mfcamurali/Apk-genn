{
  "appId": "app.lovable.foggythink",
  "appName": "Fog",
  "webDir": "www",
  "server": {
    "url": "https://foggythink.lovable.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0b0f0d"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0b0f0d",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0b0f0d",
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}